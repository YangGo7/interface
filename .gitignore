# gitignore

# local datasets / clinical samples
case/
test_dataset/
*.dcm
*.DCM
*.dicom

# model weights / checkpoints / archives
backend/weights/
*.pt
*.pth
*.ckpt
*.onnx
*.zip

# frontend build / local deps
frontend/node_modules/
frontend/dist/
frontend/*.log
frontend/temp_*.ts

# transient local scripts / snippets
fix_block*.py
temp_*.py
temp_*.txt

# post-processing outputs
backend/utils/post_processing/

# virtual env / local config
venv/
.env
.claude/
temp/
.nested-git-backups/

**/__pycache__/

